msgstr "complaints and content removal"

msgid "платні полсуги"
msgstr "paid services"

msgid "Будь ласка, увійдіть до облікового запису або зареєструйтесь"
msgstr "Please log in or register."

msgid "підтвердження володіння постами"
msgstr "post ownership confirmation"

msgid "Підтвердження володіння постами"
msgstr "Post Ownership Confirmation"

msgid ""
"Щоб підтвердити, що ці пости належать вам, перейдіть у Telegram-бота з того "
"акаунта, з якого вони були опубліковані."
msgstr ""
"To confirm that these posts belong to you, go to the Telegram bot using the "
"account from which they were published."

msgid "Після підтвердження ви зможете:"
msgstr "After confirmation, you will be able to:"

msgid "видалити пости"
msgstr "delete posts"

msgid "або перенести їх на свій обліковий запис"
msgstr "or transfer them to your account"

msgid "Перейти в Telegram-бот"
msgstr "Go to the Telegram bot"

msgid "⚠️ Переконайтесь, що ви увійшли в правильний Telegram-акаунт"
msgstr "⚠️ Make sure you are logged into the correct Telegram account"

msgid "скарга на оголошення"
msgstr "report an ad"

msgid "Скарга"
msgstr "Report"

msgid "Подати скаргу"
msgstr "Submit a report"

msgid "Коротко опишіть проблему, щоб модерація могла її перевірити."
msgstr "Briefly describe the issue so moderation can review it."

msgid "Оголошення"
msgstr "Listing"

msgid "Назад"
msgstr "Back"

msgid "Надіслати"
msgstr "Submit"

msgid "дякуємо за ваш час!"
msgstr "thank you for your time!"

msgid "заявку надіслано"
msgstr "request submitted"

msgid "дякую! Ми отримали вашу заявку і незабаром зв'яжемося з вами."
msgstr "Thank you! We have received your request and will contact you shortly."

msgid "на головну"
msgstr "go to homepage"

msgid "веріфікація користувача"
msgstr "user verification"

msgid "верифікація користувача"
msgstr "User Verification"

msgid "що потрібно для успішної верифікації"
msgstr "what is required for successful verification"

msgid "підтверджена електронна пошта"
msgstr "verified email address"

msgid "Email має бути підтверджений у профілі"
msgstr "Email must be verified in your profile"

msgid "Мінімум 1 пост"
msgstr "minimum 1 post"

msgid "оголошення має бути опубліковане з вашим email"
msgstr "the listing must be published with your email"

msgid "як проходить перевірка"
msgstr "how the verification works"

msgid "1. ви надсилаєте заявку"
msgstr "1. you submit a request"

msgid "2. ми перевіряємо акаунт"
msgstr "2. we review your account"

msgid "3. отримуєте статус"
msgstr "3. you receive a status"

msgid "Я підтверджую, що я не робот"
msgstr "I confirm that I am not a robot"

msgid "надіслати заявку"
msgstr "submit request"

msgid "верифікація студента"
msgstr "student verification"

msgid ""
"введіть свою студентську електронну пошту, щоб підтвердити статус студента."
msgstr "enter your student email address to confirm your student status"

msgid "відправити лист"
msgstr "send email"

msgid "профіль користувача"
msgstr "user profile"

msgid "на платформі з"
msgstr "on the platform since"

msgid "email веріфікован"
msgstr "email verified"

msgid "перевірений користувач"
msgstr "verified user"

msgid "перевірений студент"
msgstr "verified student"

msgid "перевірений роботодавець"
msgstr "verified employer"

msgid "поділитися профілем"
msgstr "share profile"

msgid "написати"
msgstr "message"

msgid "Прив'язка Telegram"
msgstr "Telegram linking"

