msgstr "copy this code and send it to the bot in Telegram"

msgid "код діє до"
msgstr "code is valid until"

msgid "відкрити Telegram-бота"
msgstr "open Telegram bot"

msgid "всі оголошення"
msgstr "all listings"

msgid "зібрано з Telegram"
msgstr "collected from Telegram"

msgid "У користувача немає оголошень"
msgstr "The user has no listings"

msgid "Ссылка скопирована!"
msgstr "Link copied!"

msgid "код прив'язки Telegram:"
msgstr "Telegram linking code:"

msgid "згенерувати заново"
msgstr "regenerate"

msgid "діє до:"
msgstr "valid until:"

msgid "вийти з аккаунту"
msgstr "log out"

msgid "Скопіюйте цей код і відправте його боту в Telegram:"
msgstr "Copy this code and send it to the bot in Telegram:"

msgid "Код діє до"
msgstr "Code is valid until"

msgid "Відкрити Telegram-бота"
msgstr "Open Telegram bot"

msgid "відновити оголошення за email"
msgstr "restore listings by email"

msgid "змінити профіль"
msgstr "edit profile"

msgid "пройти верифікацію"
msgstr "complete verification"

msgid "купити рекламу"
msgstr "buy advertising"

msgid "редагування профілю"
msgstr "profile editing"

msgid "оновіть основну інформацію вашого профілю"
msgstr "update your profile's basic information"

msgid "зберегти зміни"
msgstr "save changes"

msgid "Верифікація"
msgstr "Verification"

msgid "оберіть тип верифікації"
msgstr "choose verification type"

msgid "👤 користувач"
msgstr "👤 user"

msgid "підтвердження особистого профілю"
msgstr "personal profile confirmation"

msgid "пройти"
msgstr "continue"

msgid "🎓 студент"
msgstr "🎓 student"

msgid "підтвердження студентського статусу"
msgstr "student status confirmation"

msgid "💼 роботодавець"
msgstr "💼 employer"

msgid "підтвердження компанії або бізнесу"
msgstr "company or business confirmation"

msgid "Дякуємо за інтерес!"
msgstr "Thank you for your interest!"

msgid ""
"Наразі функція придбання реклами тимчасово недоступна у зв’язку із запуском "
"платформи."
msgstr ""
"The advertising purchase feature is currently temporarily unavailable due to "
"the platform launch."

msgid "Запуск очікується 15.04.2026."
msgstr "Launch is expected on 15.04.2026."

msgid "мої оголошення"
msgstr "my listings"

msgid "підняти"
msgstr "promote"

msgid "редагувати"
msgstr "edit"

msgid "Ви впевнені, що хочете видалити це оголошення?"
msgstr "Are you sure you want to delete this listing?"

msgid "Просування оголошення"
msgstr "Listing promotion"

msgid ""
"Оберіть тривалість підняття. Ваше оголошення отримає більше видимості у "
"списку."
msgstr ""
"Choose the promotion duration. Your listing will get more visibility in the "
"list."

msgid "Старт"
msgstr "Start"

msgid "3 дні"
msgstr "3 days"

msgid "Швидке підняття оголошення для короткого просування."
msgstr "Quick listing promotion for short-term visibility."

msgid "Обрати"
msgstr "Choose"

msgid "Популярний"
msgstr "Popular"

msgid "7 днів"
msgstr "7 days"

msgid "Оптимальний варіант для більш стабільного просування."
msgstr "The optimal option for more stable promotion."

msgid "Максимум"
msgstr "Maximum"

msgid "14 днів"
msgstr "14 days"

msgid "Найкраще рішення для довшого та помітнішого розміщення."
msgstr "The best solution for longer and more noticeable placement."

msgid "у вас поки що немає оголошень"
msgstr "you do not have any listings yet"

msgid "Посилання скопійовано!"
msgstr "Link copied!"

msgid "Не вдалося визначити оголошення для просування."
msgstr "Could not determine the listing for promotion."

msgid "Помилка генерації коду"
msgstr "Code generation error"

msgid "Помилка мережі"
msgstr "Network error"

msgid "верифікація роботодавця"
msgstr "employer verification"

msgid "заповніть дані компанії, щоб підтвердити статус роботодавця."
msgstr "fill in the company details to confirm your employer status"

msgid "надіслати на перевірку"
msgstr "send for review"

msgid "зміна оголошення"
msgstr "edit listing"

msgid "редагування оголошення"
msgstr "editing listing"

msgid "поточні зображення"
msgstr "current images"

msgid "видалити"
msgstr "delete"

msgid "немає зображень"
msgstr "no images"

msgid "додати зображення"
msgstr "add images"

msgid "підняття оголошення в ТОП"
msgstr "promote listing to TOP"

msgid "Підняття оголошення в ТОП"
msgstr "Promote Listing to TOP"

msgid "Оплатіть послугу безпечно через Stripe"
msgstr "Pay securely via Stripe"

msgid "Оплата тимчасово доступна лише через банківський переказ"
msgstr "Payment is temporarily available only by bank transfer"

msgid "Розділ"
msgstr "Section"

msgid "речі"
msgstr "things"

msgid "Пост"
msgstr "Post"

msgid "Цей пост вже у TOP"
msgstr "This post is already in TOP"

msgid "Повторна оплата не потрібна."
msgstr "No repeated payment is required."

msgid "Повернутися в профіль"
msgstr "Return to profile"

msgid "Сума до оплати"
msgstr "Amount to pay"

msgid "Перепрошуємо за незручності"
msgstr "We apologize for the inconvenience"

msgid ""
"Наразі онлайн-оплата тимчасово недоступна, тому просимо здійснити оплату "
"банківським переказом. Функцію онлайн-оплати буде впроваджено до 20 травня "
"включно."
msgstr ""
"Online payment is currently temporarily unavailable, so please make the "
"payment by bank transfer. The online payment feature will be implemented by "
"May 20 inclusive."

msgid "Отримувач"
msgstr "Recipient"

msgid "Сума"
msgstr "Amount"

msgid ""
"Після оплати, будь ласка, надішліть нам підтвердження в Telegram або "
"напишіть на електронну пошту."
msgstr ""
"After payment, please send us confirmation in Telegram or write to us by "
"email."

msgid "Перейти в Telegram"
msgstr "Go to Telegram"

msgid "Написати на пошту"
msgstr "Write by email"

msgid "Дані картки"
msgstr "Card details"

msgid "Оплатити"
msgstr "Pay"

msgid ""
"Натискаючи “Оплатити”, ви підтверджуєте платіж за підняття оголошення в ТОП."
msgstr ""
"By clicking “Pay”, you confirm the payment for promoting the listing to TOP."

msgid "Платіж успішний"
msgstr "Payment successful"

msgid ""
"Ваш платіж успішно оброблено. На вашу електронну пошту надіслано "
"підтвердження покупки."
msgstr ""
"Your payment has been successfully processed. A purchase confirmation has "
"been sent to your email."

msgid "Ви можете продовжити роботу з оголошенням."
msgstr "You can continue working with the listing."

